# ─── Node.js ───────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── Environment & Secrets ─────────────────────────
# NEVER commit real secrets — only commit .env.example
.env
.env.local
.env.development
.env.production
.env.test

# ─── Build outputs ──────────────────────────────────
dist/
build/
coverage/
*.log
logs/

# ─── Docker volumes (local data) ────────────────────
postgres_data/
redis_data/

# ─── OS generated files ─────────────────────────────
.DS_Store
.DS_Store?
Thumbs.db
.Spotlight-V100

# ─── IDE files ──────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ─── Terraform state (contains secrets!) ────────────
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.backup
terraform/.terraform.lock.hcl
